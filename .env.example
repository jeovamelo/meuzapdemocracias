# ============================================================================
# DEMOCRACIAS.ORG — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais (ele está no .gitignore).
# ============================================================================

# --- Supabase (app principal + chat) ---------------------------------------
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Evolution API (WhatsApp) ------------------------------------------------
# URL base da Evolution API (usada pelo app principal e pelo whatsapp-service).
EVOLUTION_API_URL=https://api.democracias.org/evolution
VITE_EVOLUTION_API_URL=https://api.democracias.org/evolution

# Chave global de administração de instâncias (obrigatória).
EVOLUTION_GLOBAL_API_KEY=
VITE_EVOLUTION_GLOBAL_API_KEY=

# Token da instância master do sistema (/pc, onboarding, cadastro público).
EVOLUTION_MASTER_TOKEN=
VITE_EVOLUTION_MASTER_TOKEN=

# Nome da instância master do WhatsApp (padrão: sistema-geral-democracias).
EVOLUTION_MASTER_INSTANCE=sistema-geral-democracias
VITE_EVOLUTION_MASTER_INSTANCE=sistema-geral-democracias

# --- whatsapp-service (servidor Express standalone) --------------------------
# Obrigatórias no arranque do serviço; sem fallback hardcoded no código.
# SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY (reutilizadas acima).
# EVOLUTION_API_KEY (pode ser igual a EVOLUTION_GLOBAL_API_KEY).

# --- Deploy VPS (scripts de infraestrutura) ----------------------------------
VPS_HOST=
VPS_USER=
VPS_PASS=
